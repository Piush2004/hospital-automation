# --- Database ---
# Leave unset to use an absolute-path SQLite file at the repo root
# (backend/app/config.py computes this so behavior doesn't depend on cwd).
# Swap to a Postgres URL later if desired.
# DATABASE_URL=sqlite:///./hospital.db

# --- Ollama (local LLM) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_FALLBACK_MODEL=llama3.1:8b-instruct-q4_K_M

# --- Auth ---
JWT_SECRET=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Payments (Razorpay Test Mode) ---
# Leave MOCK_PAYMENTS=true to simulate payments with no external account at all.
MOCK_PAYMENTS=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Base URL the mock checkout link is built from (only used when
# MOCK_PAYMENTS=true). Change if the backend isn't on localhost:8000.
APP_BASE_URL=http://localhost:8000

# --- Email (optional, never required) ---
# Reports/confirmations always work via chat. Leave SMTP_ENABLED=false to
# skip email entirely — nothing else in the app depends on it.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- WhatsApp gateway (Phase 7) ---
WHATSAPP_WEBHOOK_SECRET=change-me
WHATSAPP_GATEWAY_URL=http://localhost:3001

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
STORAGE_DIR=./storage
